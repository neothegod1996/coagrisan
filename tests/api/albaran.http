### Retrieve "albaran" object
GET {{host}}/albaran/202500060003001
Accept: application/json

### Update "albaran" object
PATCH {{host}}/albaran/202500060003001
Content-Type: application/json

{
    "general": {
        "sectoresActivados": [
            2,
            4,
            7
        ],
        "tecnicoId": 1,
        "fechaInstrucciones": "2025-02-25",
        "fechaEjecucion": "2025-03-22",
        "plazoEjecucionDias": 7,
        "pendiente": false
    },
    "riego": {
        "ce": 1.5,
        "lm2": 2.0,
