{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/**/*",
    "api-types/src/index.d.ts"
  ],
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "@src/*": ["./src/*.js"],
      "@src/*.js": ["./src/*.js"]
    },
    "typeRoots": [
      "node_modules/@types",
      "api-types/src",
      "src/types"
    ],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
